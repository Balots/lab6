# Этап 1: Кэширование npm зависимостей
FROM node:18-alpine AS dependencies
WORKDIR /app

# Копируем только package.json и package-lock.json для кэширования зависимостей
COPY react-frontend/package*.json ./

# Устанавливаем зависимости (этот слой будет закэширован)
RUN npm ci --only=production && npm cache clean --force

# Этап 2: Development зависимости для сборки
FROM node:18-alpine AS dev-dependencies
WORKDIR /app

COPY react-frontend/package*.json ./
RUN npm ci && npm cache clean --force

# Этап 3: Сборка приложения (production build)
FROM dev-dependencies AS builder
WORKDIR /app

# Копируем исходный код (изменения здесь не влияют на кэш зависимостей)
COPY react-frontend/ ./

# Собираем production build
RUN npm run build

# Этап 4: Development образ (для разработки)
FROM node:18-alpine AS development
WORKDIR /app

# Копируем зависимости из dev-dependencies
COPY --from=dev-dependencies /app/node_modules ./node_modules
COPY react-frontend/ ./

ENV PORT=3080
ENV HOST=0.0.0.0
ENV NODE_ENV=development

RUN adduser -D appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 3080

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3080 || exit 1

CMD ["npm", "start"]

# Этап 5: Production образ с nginx
FROM nginx:alpine AS production
WORKDIR /usr/share/nginx/html

# Удаляем дефолтный nginx static assets
RUN rm -rf ./*

# Копируем собранное приложение из builder
COPY --from=builder /app/build .

# Копируем конфигурацию nginx для SPA
RUN echo 'server { \
    listen 80; \
    server_name _; \
    root /usr/share/nginx/html; \
    index index.html; \
    location / { \
        try_files $uri $uri/ /index.html; \
    } \
    location /api { \
        proxy_pass http://backend:8080; \
        proxy_set_header Host $host; \
        proxy_set_header X-Real-IP $remote_addr; \
    } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:80 || exit 1

CMD ["nginx", "-g", "daemon off;"]

